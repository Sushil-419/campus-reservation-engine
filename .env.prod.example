# Copy to .env.prod on the server and fill in real values. Placeholders only.
# Start with: docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# IMPORTANT: a blank "KEY=" line is NOT "unset" - it is an empty string, which
# breaks number/boolean settings (e.g. SMTP_PORT=) and overrides text defaults.
# Keep unused optional keys COMMENTED OUT.
#
# DATABASE_URL is built by docker-compose.prod.yml from POSTGRES_PASSWORD.

# ── Required ───────────────────────────────────────────────────────────────
DOMAIN=<DOMAIN>
POSTGRES_PASSWORD=<strong-random-password>
BASE_URL=https://<DOMAIN>
ADMIN_EMAIL=<admin@example.com>
COOKIE_SECURE=true
CORS_ORIGINS=https://<DOMAIN>
JOBS_ENABLED=true
REALTIME_ENABLED=true

# ── Email (optional; without SMTP_USER/SMTP_PASSWORD emails go to the log) ─
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=<smtp-user>
# SMTP_PASSWORD=<smtp-password>
# SMTP_FROM=<from-address>

# ── Chatbot (optional; disabled without an API key) ────────────────────────
# GROQ_API_KEY=<groq-api-key>

# ── Google sign-in (optional; disabled without client id/secret) ───────────
# GOOGLE_CLIENT_ID=<google-client-id>
# GOOGLE_CLIENT_SECRET=<google-client-secret>
# GOOGLE_REDIRECT_URI=https://<DOMAIN>/auth/google/callback
